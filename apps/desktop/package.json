{
  "name": "@tandem/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "mock-service": "tsx test/mock-service.ts",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "node build-main.mjs",
    "start": "pnpm build:main && electron .",
    "package": "pnpm build:main && pnpm build:renderer && ./build/package.sh",
    "package:dmg": "pnpm build:main && pnpm build:renderer && TANDEM_TARGET=dmg ./build/package.sh",
    "package:win": "pnpm build:main && pnpm build:renderer && electron-builder --win --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tandem/core": "workspace:*",
    "@tandem/service": "workspace:*",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bubble-menu": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-collaboration-caret": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lib0": "^0.2.119",
    "marked": "^18.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.3.4",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "main": "dist/main/main.cjs",
  "productName": "Tandem",
  "description": "Write and review Markdown plans with agents",
  "author": "Farspeak Labs",
  "license": "MIT"
}
